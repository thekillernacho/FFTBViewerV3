modules = ["java", "java-21", "maven", "java-11", "python-3.11", "nodejs-20", "postgresql-16"]

[nix]
channel = "stable-24_05"
packages = ["redis", "maven", "jdk11"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Quick Tests"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Build Project"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Frontend Tests"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Run Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Final Server"

[[workflows.workflow]]
name = "Quick Tests"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/workspace && ./scripts/quick-test.sh"

[[workflows.workflow]]
name = "Build Project"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/workspace && export JAVA_HOME=/nix/store/023zqb5jvvjhv5l1b0fzdaqxy8c7ilcl-adoptopenjdk-openj9-bin-11.0.11 && export PATH=$JAVA_HOME/bin:$PWD/maven/bin:$PATH && echo \"Starting build process...\" && mvn clean install -Dmaven.test.skip=true && echo \"Build complete! JAR file created at target/twitch-chat-reader-1.0.0.jar\""

[[workflows.workflow]]
name = "Frontend Tests"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/workspace && npx jest frontend/tests/ --verbose"

[[workflows.workflow]]
name = "Run Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/workspace && export JAVA_HOME=/nix/store/023zqb5jvvjhv5l1b0fzdaqxy8c7ilcl-adoptopenjdk-openj9-bin-11.0.11 && export PATH=$JAVA_HOME/bin:$PATH && java -jar target/twitch-chat-reader-1.0.0.jar --server.port=5000 --spring.profiles.active=prod"
waitForPort = 5000

[[workflows.workflow]]
name = "Final Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/workspace && export JAVA_HOME=/nix/store/023zqb5jvvjhv5l1b0fzdaqxy8c7ilcl-adoptopenjdk-openj9-bin-11.0.11 && export PATH=$JAVA_HOME/bin:$PATH && java -Dspring.profiles.active=dev -Dlogging.level.root=ERROR -jar target/twitch-chat-reader-1.0.0.jar --server.port=5000"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3000

[deployment]
deploymentTarget = "vm"
run = ["java", "-jar", "target/twitch-chat-reader-1.0.0.jar", "--server.port=5000", "--spring.profiles.active=prod"]
build = ["mvn", "clean", "install", "-Dmaven.test.skip=true"]

[agent]
expertMode = true

[userenv]

[userenv.production]
JAVA_HOME = "/nix/store/023zqb5jvvjhv5l1b0fzdaqxy8c7ilcl-adoptopenjdk-openj9-bin-11.0.11"
